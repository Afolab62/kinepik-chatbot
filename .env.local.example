# =============================================================================
# KINEPIK Assistant – Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# --- Required: AI Provider ---
# Option A: OpenAI (default)
OPENAI_API_KEY=sk-...

# Option B: BioChatter Server
# Run a local biochatter-server (https://github.com/biocypher/biochatter-server)
# and set these to point at it. The server exposes an OpenAI-compatible endpoint.
# BIOCHATTER_API_URL=http://localhost:8000/v1
# BIOCHATTER_API_KEY=your-key-here
# BIOCHATTER_MODEL=gpt-4o          # model served by your BioChatter instance

# Option C: OpenRouter (access claude-3-5-sonnet, etc.)
# BIOCHATTER_API_URL=https://openrouter.ai/api/v1
# BIOCHATTER_API_KEY=sk-or-...
# BIOCHATTER_MODEL=anthropic/claude-sonnet-4-20250514
