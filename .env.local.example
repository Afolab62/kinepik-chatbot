# =============================================================================
# KINEPIK Assistant – Environment Variables
# Copy this file to .env.local and fill in your values
# =============================================================================

# --- Required: AI Provider ---
# Option A: OpenAI (default)
OPENAI_API_KEY=sk-...

# Option B: OpenRouter-compatible providers
# You can also point to a compatible OpenAI-style endpoint here.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_API_KEY=sk-or-...
# OPENAI_MODEL=anthropic/claude-sonnet-4-20250514

# Optional explicit model override (default in code: gpt-4.1-mini)
# OPENAI_MODEL=gpt-4.1-mini

# --- Optional: Native OpenAI web search fallback ---
# Set ENABLE_WEB_SEARCH=true to allow GPT-5 to use OpenAI's native web_search tool
# for speculative or literature-backed biomedical questions.
# ENABLE_WEB_SEARCH=false
# WEB_SEARCH_ALLOWED_DOMAINS=pubmed.ncbi.nlm.nih.gov,ncbi.nlm.nih.gov,nature.com,cell.com,sciencedirect.com,jci.org,ashpublications.org

# --- Optional: Runtime safety and operations ---
# Basic per-IP API throttling for /api/chat
# CHAT_RATE_LIMIT_WINDOW_MS=60000
# CHAT_RATE_LIMIT_MAX_REQUESTS=30

# Optional token marker for ops health endpoint governance
# OPS_HEALTH_TOKEN=replace-with-a-random-value
# OPS_HEALTH_ENABLED=true

